# Copy this file to .env and add your free Groq API key.
# Part A (fs_tools.py) does not need any API key.
# Part B (llm_file_assistant.py) uses the Groq API (free tier).

# Groq (free tier) -> https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default model (must support tool calling)
GROQ_MODEL=llama-3.3-70b-versatile
